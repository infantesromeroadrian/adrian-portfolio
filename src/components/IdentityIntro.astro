  <div class="identity-visual">
    <button
      type="button"
      class="identity-frame"
      data-identity-frame
      aria-label="Reveal the l4tentnoise cover as an AI Red Teamer"
      aria-pressed="false"
    >
      <span class="identity-cover identity-cover--offensive" aria-hidden="true">
        <img
          src="/images/l4tentnoise-ai-red-team-cover-800.webp"
          srcset="/images/l4tentnoise-ai-red-team-cover-480.webp 480w, /images/l4tentnoise-ai-red-team-cover-800.webp 800w, /images/l4tentnoise-ai-red-team-cover-1122.webp 1122w"
          sizes="(max-width: 60rem) 40vw, 36rem"
          alt=""
          width="1122"
          height="1402"
          decoding="async"
          fetchpriority="low"
          draggable="false"
