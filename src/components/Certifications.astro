---
type Certification = {
  title: string;
  issuer: string;
  credentialId?: string;
  verificationUrl?: string;
};

const certifications: readonly Certification[] = [
  {
    title: "AWS Certified Generative AI Developer – Professional",
    issuer: "Amazon Web Services",
  },
  {
    title: "AWS Certified Security – Specialty",
    issuer: "Amazon Web Services",
  },
];
---

<section class="certifications" id="certifications" aria-labelledby="certifications-title">
  <h2 id="certifications-title">Certifications</h2>
  <ul class="certification-grid" role="list">
    {certifications.map((certification) => (
      <li class="certification">
        <h3>{certification.title}</h3>
        <p class="certification-issuer">{certification.issuer}</p>
        {certification.credentialId && (
          <p class="certification-credential">Credential ID: {certification.credentialId}</p>
        )}
        {certification.verificationUrl && (
          <a
            class="certification-link"
            href={certification.verificationUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Verify ${certification.title} credential (opens in a new tab)`}
          >
            Verify credential <span aria-hidden="true">↗</span>
          </a>
        )}
        <p class="certification-status">Completed</p>
      </li>
    ))}
  </ul>
</section>
