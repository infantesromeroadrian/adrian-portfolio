---
import { architectureStudies } from "../lib/public-work";
---

<section class="aws-architect" id="aws-architect" aria-labelledby="aws-architect-title">
  <header class="aws-architect__heading">
    <p class="aws-architect__folio-note">Architecture folio / Plates 01–05</p>
    <h2 id="aws-architect-title">AWS Architect</h2>
    <p class="aws-architect__introduction">
      Five architecture studies in controlled, observable AI systems on AWS.
      Explore each problem, decision and limitation in an interactive map.
    </p>
  </header>

  <ol class="architecture-plates" role="list">
    {architectureStudies.map((plate, index) => (
      <li>
        <figure class="architecture-plate">
          <a
            class="architecture-plate__preview"
            href={plate.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Explore ${plate.title} interactive architecture map (opens in a new tab)`}
          >
            <img
              src={plate.preview}
              alt={plate.previewAlt}
              width="960"
              height="600"
              loading="lazy"
              decoding="async"
            />
          </a>

          <figcaption class="architecture-plate__caption">
            <p class="architecture-plate__number" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </p>
            <h3>{plate.title}</h3>
            <dl class="architecture-plate__decisions">
              <div><dt>Problem</dt><dd>{plate.problem}</dd></div>
              <div><dt>Decision</dt><dd>{plate.decision}</dd></div>
              <div><dt>Limitation</dt><dd>{plate.limitation}</dd></div>
            </dl>
            <dl class="architecture-plate__scope">
              <dt>Technical scope</dt>
              <dd>{plate.scope}</dd>
            </dl>
            <a
              class="architecture-plate__text-link"
              href={plate.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Explore ${plate.title} interactive architecture map (opens in a new tab)`}
            >
              Explore interactive map <span aria-hidden="true">↗</span>
            </a>
          </figcaption>
        </figure>
      </li>
    ))}
  </ol>
</section>
