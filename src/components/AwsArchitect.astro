---
import {
  architectureStudies,
  protectedAgentCase,
  protectedAgentStudy as featured,
  protectedAgentWriteUp,
} from "../lib/public-work";

const otherStudies = architectureStudies.filter((study) => study.href !== featured.href);
---

<section class="aws-architect" id="aws-architect" aria-labelledby="aws-architect-title">
  <header class="aws-architect__heading">
    <p class="aws-architect__folio-note">Selected work / Five architecture studies</p>
    <h2 id="aws-architect-title">AWS Architect</h2>
    <p class="aws-architect__introduction">
      Architectures for controlled, observable AI systems. Start with the boundary
      between what a model says and what an application permits.
    </p>
  </header>

  <article class="architecture-feature" aria-labelledby="featured-study-title">
    <a class="architecture-plate__preview" href={protectedAgentCase.href} aria-label={`Read ${featured.title} architecture study`}>
      <img src={featured.preview} alt={featured.previewAlt} width="960" height="600" loading="lazy" decoding="async" />
    </a>
    <div class="architecture-feature__body">
      <p class="architecture-feature__label">Featured study</p>
      <h3 id="featured-study-title"><a href={protectedAgentCase.href}>{featured.title}</a></h3>
      <dl class="architecture-plate__decisions">
        <div><dt>Problem</dt><dd>{featured.problem}</dd></div>
        <div><dt>Decision</dt><dd>{featured.decision}</dd></div>
        <div><dt>Limitation</dt><dd>{featured.limitation}</dd></div>
      </dl>
      <p class="architecture-study__scope"><span>Technical scope</span>{featured.scope}</p>
      <a class="architecture-study__link" href={protectedAgentCase.href}>Read the architecture study <span aria-hidden="true">→</span></a>
    </div>
    <p class="architecture-feature__connection">
      <span>Related attack lesson</span>
      <a href={protectedAgentWriteUp.href} target="_blank" rel="noopener noreferrer">
        {protectedAgentWriteUp.title}<span class="visually-hidden"> (opens in a new tab)</span>
      </a>
      <small>A thematic connection, not validation of this runtime.</small>
    </p>
  </article>

  <h3 class="architecture-index-title">More architecture studies</h3>
  <ul class="architecture-index" role="list">
    {otherStudies.map((study) => (
      <li class="architecture-row">
        <a class="architecture-plate__preview" href={study.href} target="_blank" rel="noopener noreferrer" aria-label={`Explore ${study.title} interactive map (opens in a new tab)`}>
          <img src={study.preview} alt={study.previewAlt} width="960" height="600" loading="lazy" decoding="async" />
        </a>
        <div class="architecture-row__body">
          <h4>{study.title}</h4>
          <p class="architecture-row__problem">{study.problem}</p>
          <p class="architecture-study__scope"><span>Technical scope</span>{study.scope}</p>
          <details class="architecture-details">
            <summary>Decision and limitation<span class="visually-hidden"> for {study.title}</span></summary>
            <dl class="architecture-plate__decisions">
              <div><dt>Decision</dt><dd>{study.decision}</dd></div>
              <div><dt>Limitation</dt><dd>{study.limitation}</dd></div>
            </dl>
          </details>
          <a class="architecture-study__link" href={study.href} target="_blank" rel="noopener noreferrer">
            Explore interactive map <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </div>
      </li>
    ))}
  </ul>
</section>
