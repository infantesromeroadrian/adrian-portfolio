---
import { architectureStudies, protectedAgentCase } from "../lib/public-work";
import { professionalCases, professionalCasePaths, FEATURED_PROFESSIONAL_SLUG } from "../lib/professional-work";

const featured = professionalCases.find((study) => study.slug === FEATURED_PROFESSIONAL_SLUG);
if (!featured) throw new Error("The featured professional case must exist in the catalogue.");
const featuredPaths = professionalCasePaths(featured.slug);
const otherCases = professionalCases.filter((study) => study.slug !== featured.slug);
---

<section class="aws-architect" id="aws-architect" aria-labelledby="aws-architect-title">
  <header class="aws-architect__heading">
    <p class="aws-architect__folio-note">Selected work / Five professional cases</p>
    <h2 id="aws-architect-title">AI systems.<br />Clear boundaries.</h2>
    <p class="aws-architect__introduction">
      My work on safer AI applications, evaluation and cloud infrastructure.
      Anonymized accounts of my contribution, the team's part and what the evidence supports.
    </p>
  </header>

  <article class="architecture-feature" aria-labelledby="featured-study-title">
    <a class="architecture-plate__preview" href={featuredPaths.page} aria-label={`Read ${featured.title}`}>
      <img src={featuredPaths.preview} alt={featured.previewAlt} width="960" height="600" loading="lazy" decoding="async" />
    </a>
    <div class="architecture-feature__body">
      <p class="architecture-feature__label">Featured professional case</p>
      <h3 id="featured-study-title"><a href={featuredPaths.page}>{featured.title}</a></h3>
      <p class="architecture-row__problem">{featured.introduction}</p>
      <p class="architecture-study__scope"><span>Scope</span>{featured.scope}</p>
      <a class="architecture-study__link" href={featuredPaths.page}>Read the case <span aria-hidden="true">→</span></a>
    </div>
  </article>

  <h3 class="architecture-index-title">More professional work</h3>
  <ul class="architecture-index" role="list">
    {otherCases.map((study) => {
      const paths = professionalCasePaths(study.slug);
      return (
        <li class="architecture-row">
          <a class="architecture-plate__preview" href={paths.page} aria-label={`Read ${study.title}`}>
            <img src={paths.preview} alt={study.previewAlt} width="960" height="600" loading="lazy" decoding="async" />
          </a>
          <div class="architecture-row__body">
            <h4><a href={paths.page}>{study.title}</a></h4>
            <p class="architecture-row__problem">{study.introduction}</p>
            <p class="architecture-study__scope"><span>Scope</span>{study.scope}</p>
            <a class="architecture-study__link" href={paths.page}>Read the case <span aria-hidden="true">→</span></a>
          </div>
        </li>
      );
    })}
  </ul>

  <article class="harness-reference" id="arca-harness" aria-labelledby="arca-harness-title">
    <header>
      <p class="architecture-feature__label">Personal project / Public repository</p>
      <h3 id="arca-harness-title">ARCA harness</h3>
    </header>
    <div class="harness-reference__body">
      <p>
        One operating identity with specialist agents, skills, hooks and memory
        conventions, adapted to Claude Code, Codex, Grok Build, Kimi Code and OpenCode.
      </p>
      <p>
        The repository documents an allowlist-driven exporter that requires a
        leak-check gate before publication.
      </p>
      <a
        class="architecture-study__link"
        href="https://github.com/infantesromeroadrian/harness"
        target="_blank"
        rel="noopener noreferrer"
      >
        Browse the harness <span aria-hidden="true">↗</span>
        <span class="visually-hidden"> (opens in a new tab)</span>
      </a>
    </div>
  </article>

  <details class="conceptual-studies">
    <summary>Conceptual architecture studies <span>Five additional explorations</span></summary>
    <p class="conceptual-studies__introduction">
      These are separate design studies, not accounts of client implementations.
      Each explains a problem, a decision and its limits through an interactive map.
    </p>
    <ul class="conceptual-studies__list" role="list">
      {architectureStudies.map((study) => (
        <li>
          <details class="conceptual-study">
            <summary>{study.title}</summary>
            <div class="conceptual-study__body">
              <a class="architecture-plate__preview" href={study.href} target="_blank" rel="noopener noreferrer" aria-label={`Explore ${study.title} conceptual map (opens in a new tab)`}>
                <img src={study.preview} alt={study.previewAlt} width="960" height="600" loading="lazy" decoding="async" />
              </a>
              <div>
                <dl class="architecture-plate__decisions">
                  <div><dt>Problem</dt><dd>{study.problem}</dd></div>
                  <div><dt>Decision</dt><dd>{study.decision}</dd></div>
                  <div><dt>Limitation</dt><dd>{study.limitation}</dd></div>
                </dl>
                <p class="architecture-study__scope"><span>Technical scope</span>{study.scope}</p>
                <a class="architecture-study__link" href={study.href} target="_blank" rel="noopener noreferrer">Explore interactive map <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
                {study.href === protectedAgentCase.studyHref && (
                  <a class="architecture-study__link" href={protectedAgentCase.href}>Read the conceptual study <span aria-hidden="true">→</span></a>
                )}
              </div>
            </div>
          </details>
        </li>
      ))}
    </ul>
  </details>
</section>
