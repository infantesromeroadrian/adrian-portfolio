---
import { CHAT_COPY, GUIDED_PROMPTS } from "../lib/chat-presentation";
import { MAX_USER_CHARACTERS } from "../lib/chat-contract";
const copy = CHAT_COPY.en;
---

<aside class="portfolio-chat" lang="en" aria-label={copy.assistantLabel} data-portfolio-chat>
  <section
    class="portfolio-chat__panel"
    id="portfolio-chat-panel"
    role="dialog"
    aria-modal="false"
    aria-labelledby="portfolio-chat-title"
    aria-describedby="portfolio-chat-notice"
    aria-busy="false"
    hidden
    data-chat-panel
  >
    <header class="portfolio-chat__header">
      <div>
        <p class="portfolio-chat__eyebrow" data-chat-copy="eyebrow">{copy.eyebrow}</p>
        <h2 id="portfolio-chat-title" data-chat-copy="title">{copy.title}</h2>
      </div>
      <div class="portfolio-chat__header-actions">
        <label class="visually-hidden" for="portfolio-chat-language" data-chat-copy="language">{copy.language}</label>
        <select id="portfolio-chat-language" class="portfolio-chat__language" data-chat-language>
          <option value="en" lang="en" selected>EN</option>
          <option value="es" lang="es">ES</option>
        </select>
        <button class="portfolio-chat__close" type="button" aria-label={copy.close} data-chat-close>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
      </div>
    </header>

    <div class="portfolio-chat__body" data-chat-body>
      <details class="portfolio-chat__guide" open data-chat-guide>
        <summary data-chat-copy="guide">{copy.guide}</summary>
        <div class="portfolio-chat__starters">
          {GUIDED_PROMPTS.en.map((starter) => (
            <button type="button" data-chat-starter={starter.id} title={starter.prompt}>
              {starter.label}
            </button>
          ))}
        </div>
      </details>
      <p class="portfolio-chat__notice" id="portfolio-chat-notice" data-chat-copy="notice">
        {copy.notice}
      </p>
      <details class="portfolio-chat__security">
        <summary data-chat-copy="security">{copy.security}</summary>
        <ul>
          <li data-chat-copy="publicFacts">{copy.publicFacts}</li>
          <li data-chat-copy="untrusted">{copy.untrusted}</li>
          <li data-chat-copy="rateLimited">{copy.rateLimited}</li>
          <li data-chat-copy="plainText">{copy.plainText}</li>
        </ul>
      </details>
      <p class="portfolio-chat__status" role="status" aria-live="polite" data-chat-status>
        {copy.checking}
      </p>
      <button class="portfolio-chat__retry" type="button" hidden data-chat-retry data-chat-copy="retry">
        {copy.retry}
      </button>
      <div
        class="portfolio-chat__messages"
        role="log"
        aria-label={copy.conversation}
        aria-live="polite"
        aria-relevant="additions"
        data-chat-messages
      ></div>
      <p class="portfolio-chat__error" aria-live="polite" hidden data-chat-error></p>
    </div>

    <form class="portfolio-chat__form" data-chat-form>
      <label for="portfolio-chat-message" data-chat-copy="inputLabel">{copy.inputLabel}</label>
      <textarea
        id="portfolio-chat-message"
        name="message"
        rows="2"
        maxlength={MAX_USER_CHARACTERS * 2}
        placeholder={copy.placeholder}
        autocomplete="off"
        disabled
        data-chat-input
      ></textarea>
      <div class="portfolio-chat__form-actions">
        <span aria-live="polite" data-chat-count>0 / 2000</span>
        <button type="submit" disabled data-chat-submit>Send</button>
      </div>
      <button class="portfolio-chat__pause" type="button" aria-pressed="false" data-orb-pause>
        {copy.pauseOrb}
      </button>
    </form>
  </section>

  <button
    class="portfolio-chat__toggle"
    type="button"
    aria-label={copy.open}
    aria-controls="portfolio-chat-panel"
    aria-expanded="false"
    data-chat-toggle
  >
    <svg class="portfolio-chat__fallback" viewBox="0 0 72 72" aria-hidden="true">
      <circle cx="36" cy="36" r="27"></circle>
      <path d="M36 9l21 14v26L36 63 15 49V23zM15 23l42 26M15 49l42-26M36 9v54"></path>
      <g>
        <circle cx="36" cy="9" r="1.75"></circle>
        <circle cx="15" cy="23" r="1.75"></circle>
        <circle cx="57" cy="49" r="1.75"></circle>
        <circle cx="36" cy="63" r="1.75"></circle>
      </g>
    </svg>
    <canvas width="72" height="72" aria-hidden="true" data-orb-canvas></canvas>
    <svg class="portfolio-chat__toggle-close" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18"></path>
    </svg>
    <span class="portfolio-chat__toggle-label" data-chat-copy="toggle">{copy.toggle}</span>
  </button>

  <noscript>
    <p class="portfolio-chat__noscript">
      The AI assistant needs JavaScript. The rest of the portfolio remains available.
    </p>
  </noscript>
</aside>

<script>
  import "../scripts/chat-widget";
</script>
