---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <header class="contact-heading">
    <h2 id="contact-title">Contact</h2>
    <p class="contact-introduction">
      Available for AI security architecture and AI red-team engagements.
    </p>
  </header>

  <div class="contact-body">
    <a
      class="contact-cta"
      href="https://www.linkedin.com/in/adrianinfantes/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Message Adrian Infantes on LinkedIn (opens in a new tab)"
    >
      Message me on LinkedIn <span aria-hidden="true">↗</span>
    </a>

    <ul class="contact-profiles" role="list" aria-label="Public profiles">
      {profiles.map((profile) => (
        <li>
          <a
            href={profile.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`View ${profile.name} (opens in a new tab)`}
            title={profile.label}
          >
            {profile.label === "Medium" ? (
              <svg viewBox="0 0 48 28" aria-hidden="true" focusable="false">
                <circle cx="13" cy="14" r="11" />
                <ellipse cx="33" cy="14" rx="6.5" ry="10.5" />
                <ellipse cx="44" cy="14" rx="2.5" ry="8.5" />
              </svg>
            ) : (
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d={profilePaths[profile.label]} />
              </svg>
            )}
          </a>
        </li>
      ))}
    </ul>

    <p class="contact-note">
      The AI assistant on this page is a small security exercise of its own: it answers
      only from public facts, treats visitor messages as untrusted data, is rate-limited,
      and replies in plain text.
    </p>
  </div>
</section>
