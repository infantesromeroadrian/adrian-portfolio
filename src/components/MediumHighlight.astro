---
import { securityWriteUps } from "../lib/public-work";
---

<section class="medium-highlight" aria-labelledby="medium-title">
  <header class="medium-heading">
    <h2 id="medium-title">AI Security Write-ups</h2>
    <p class="medium-introduction">
      Four Hack The Box challenge analyses and reproductions, focused on defensive lessons and the limits of the evidence. Published on Medium.
    </p>
  </header>

  <ol class="write-up-list" role="list">
    {securityWriteUps.map((writeUp) => (
      <li>
        <article class="write-up-row">
          {writeUp.scope === "Partial HTB challenge reproduction" && (
            <p class="write-up-row__scope">Partial reproduction</p>
          )}
          <h3>
            <a href={writeUp.href} target="_blank" rel="noopener noreferrer">
              {writeUp.title}<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </h3>
          <p class="write-up-row__takeaway">{writeUp.takeaway}</p>
        </article>
      </li>
    ))}
  </ol>

</section>
