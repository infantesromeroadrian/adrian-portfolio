---
import { securityWriteUps } from "../lib/public-work";
---

<section class="medium-highlight" aria-labelledby="medium-title">
  <header class="medium-heading">
    <h2 id="medium-title">AI Security Write-ups</h2>
    <p class="medium-introduction">
      Four analyses of Hack The Box labs, focused on defensive lessons and the limits of the evidence.
    </p>
  </header>

  <ol class="write-up-cards" role="list">
    {securityWriteUps.map((writeUp, index) => (
      <li>
        <article class="write-up-card">
          <p class="write-up-card__scope">
            <span aria-hidden="true">{String(index + 1).padStart(2, "0")} / </span>
            {writeUp.scope}
          </p>
          <h3>
            <a href={writeUp.href} target="_blank" rel="noopener noreferrer">
              {writeUp.title}<span class="visually-hidden"> (opens in a new tab)</span>
              <span aria-hidden="true"> ↗</span>
            </a>
          </h3>
          <p class="write-up-card__takeaway">{writeUp.takeaway}</p>
        </article>
      </li>
    ))}
  </ol>

  <nav class="public-profiles" aria-label="Writing and public profiles">
    <a
      class="public-profile-link public-profile-link--medium"
      href="https://medium.com/@infantesromeroadrian"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Read @infantesromeroadrian on Medium (opens in a new tab)"
    >
      <svg class="medium-brand" viewBox="0 0 48 28" aria-hidden="true" focusable="false">
        <circle cx="13" cy="14" r="11"></circle>
        <ellipse cx="33" cy="14" rx="6.5" ry="10.5"></ellipse>
        <ellipse cx="44" cy="14" rx="2.5" ry="8.5"></ellipse>
      </svg>
      <span>Medium</span>
    </a>
    <a
      class="public-profile-link"
      href="https://www.linkedin.com/in/adrianinfantes/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="View Adrian Infantes on LinkedIn (opens in a new tab)"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M5.3 3.8a2.3 2.3 0 1 1 0 4.6 2.3 2.3 0 0 1 0-4.6ZM3.4 10h3.8v10.6H3.4V10Zm6.1 0h3.6v1.5h.1c.5-.9 1.7-1.9 3.5-1.9 3.8 0 4.5 2.3 4.5 5.4v5.6h-3.8v-5c0-1.2 0-2.8-1.9-2.8s-2.2 1.4-2.2 2.7v5.1H9.5V10Z"></path>
      </svg>
      <span>LinkedIn</span>
    </a>
    <a
      class="public-profile-link"
      href="https://github.com/infantesromeroadrian"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="View infantesromeroadrian on GitHub (opens in a new tab)"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 2.3a9.9 9.9 0 0 0-3.1 19.3c.5.1.7-.2.7-.5v-1.9c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 0 1.6 1 1.6 1 .9 1.6 2.4 1.1 2.9.9.1-.7.4-1.1.7-1.4-2.3-.3-4.7-1.1-4.7-4.9 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.7 9.7 0 0 1 5 0c1.9-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.8-2.4 4.6-4.7 4.9.4.3.7 1 .7 1.9v2.8c0 .3.2.6.7.5A9.9 9.9 0 0 0 12 2.3Z"></path>
      </svg>
      <span>GitHub</span>
    </a>
    <a
      class="public-profile-link"
      href="https://x.com/infantes_adrian"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="View infantes_adrian on X (opens in a new tab)"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M18.9 3h3.7l-8 9.2L24 21h-7.4l-5.8-7.6L4.2 21H.5l8.6-9.8L.1 3h7.6l5.2 6.9L18.9 3Zm-1.3 16h2L6.6 4.9H4.5L17.6 19Z"></path>
      </svg>
      <span>X</span>
    </a>
  </nav>
</section>
